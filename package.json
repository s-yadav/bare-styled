{
  "version": "1.0.0",
  "name": "just-styled",
  "description": "styled-components without the wrapper fiber: a build-time transform (Babel or oxc) + a JSX-runtime that resolves styled components to plain host elements. Transform machinery originally forked from babel-plugin-styled-components.",
  "main": "packages/runtime/src/index.js",
  "exports": {
    ".": "./packages/runtime/src/index.js",
    "./runtime": "./packages/runtime/src/index.js",
    "./runtime/patch": "./packages/runtime/src/patch.js",
    "./jsx-runtime": "./packages/runtime/src/jsx-runtime.js",
    "./jsx-dev-runtime": "./packages/runtime/src/jsx-dev-runtime.js",
    "./transform": "./lib/index.js",
    "./fast-transform": "./lib/fast-transform.js",
    "./vite": {
      "types": "./types/vite-plugin.d.ts",
      "default": "./lib/vite-plugin.js"
    },
    "./types": {
      "types": "./types/styled-components-augment.d.ts",
      "default": "./types/augment-stub.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types",
    "vendor",
    "packages/runtime/src",
    "LICENSE.md",
    "README.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/plugin-syntax-typescript": "^7.25.9",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.29.7",
    "@changesets/cli": "2.31.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "babel-test": "^0.2.4",
    "esbuild": "^0.23.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-file-snapshot": "^0.5.0",
    "prettier": "^3.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.0.1",
    "styled-components": "^6.1.14"
  },
  "dependencies": {
    "@babel/helper-annotate-as-pure": "^7.25.9",
    "@babel/helper-module-imports": "^7.25.9",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@babel/plugin-syntax-typescript": "^7.25.9",
    "@emotion/is-prop-valid": "^1.4.0",
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.139.0",
    "picomatch": "^4.0.2",
    "stylis": "^4.3.6"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0",
    "react": ">=16.8.0",
    "styled-components": ">= 2"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "rimraf lib",
    "style": "prettier --write src/**/*.js",
    "build": "babel src -d lib",
    "test": "jest",
    "test:watch": "pnpm test -- --watch",
    "prepublishOnly": "pnpm clean && pnpm build",
    "changeset": "changeset",
    "changeset-publish": "pnpm build && changeset publish"
  },
  "keywords": [
    "styled-components",
    "css-in-js",
    "compile-time",
    "oxc",
    "fiber-free"
  ],
  "jest": {
    "testEnvironment": "node",
    "snapshotSerializers": [
      "<rootDir>/test/whitespaceTrimmingSerializer.js"
    ],
    "watchPathIgnorePatterns": [
      "fixtures\\/[^/]+\\/(output|error)\\.js"
    ],
    "moduleNameMapper": {
      "^just-styled/runtime/patch$": "<rootDir>/packages/runtime/src/patch.js",
      "^just-styled/runtime$": "<rootDir>/packages/runtime/src/index.js",
      "^just-styled/jsx-runtime$": "<rootDir>/packages/runtime/src/jsx-runtime.js",
      "^just-styled/jsx-dev-runtime$": "<rootDir>/packages/runtime/src/jsx-dev-runtime.js"
    }
  },
  "packageManager": "pnpm@11.1.3"
}
